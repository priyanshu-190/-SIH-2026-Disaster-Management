async function loadAuthorityMissionProgress(incidentId) {

    const badge =
        document.getElementById(
            "authorityMissionStatusBadge"
        );

    const timeline =
        document.getElementById(
            "authorityMissionTimeline"
        );

    if (!badge || !timeline) return;


    try {

        const response =
            await fetch("/api/missions");

        if (!response.ok) {

            throw new Error(
                "Failed to load missions"
            );

        }


        const missions =
            await response.json();


        // Find mission belonging to selected incident

        const mission =
            missions.find(
                m =>
                    String(m.incidentId) ===
                    String(incidentId)
            );


        // --------------------------------------------------------
        // NO MISSION
        // --------------------------------------------------------

        if (!mission) {

            badge.textContent =
                "NO MISSION";

            badge.className =
                "text-xs font-bold px-3 py-1 rounded-full bg-slate-100 text-slate-500";


            timeline.innerHTML = `

                <div class="text-sm text-slate-400 text-center">
                    No relief team has been dispatched to this incident yet.
                </div>

            `;

            return;
        }


        // --------------------------------------------------------
        // STATUS
        // --------------------------------------------------------

        const currentStatus =
            String(
                mission.status || "WAITING"
            ).toUpperCase();


        // --------------------------------------------------------
        // STATUS BADGE
        // --------------------------------------------------------

        const badgeText = {

            WAITING: "WAITING",

            ACCEPTED: "ACCEPTED",

            EN_ROUTE: "EN ROUTE",

            ARRIVED: "ON SITE",

            RESCUE: "RESCUE ACTIVE",

            RESCUE_STARTED: "RESCUE ACTIVE",

            COMPLETE: "COMPLETE",

            ESCALATED: "ESCALATED"

        };


        badge.textContent =
            badgeText[currentStatus] ||
            currentStatus;


        badge.className =
            "text-xs font-bold px-3 py-1 rounded-full bg-blue-100 text-blue-700";


        // --------------------------------------------------------
        // FIVE MAIN PROGRESS STEPS
        // --------------------------------------------------------

        const steps = [

            {
                status: "ACCEPTED",
                title: "ACCEPTED",
                subtitle: "Order received"
            },

            {
                status: "EN_ROUTE",
                title: "EN ROUTE",
                subtitle: "Unit moving to incident"
            },

            {
                status: "ARRIVED",
                title: "ON SITE",
                subtitle: "Team has arrived"
            },

            {
                status: "RESCUE_STARTED",
                title: "RESCUE ACTIVE",
                subtitle: "Rescue operation active"
            },

            {
                status: "COMPLETE",
                title: "COMPLETE",
                subtitle: "Mission completed"
            }

        ];


        const statusOrder = {

            WAITING: 0,

            ACCEPTED: 1,

            EN_ROUTE: 2,

            ARRIVED: 3,

            RESCUE: 4,

            RESCUE_STARTED: 4,

            COMPLETE: 5,

            ESCALATED: 0

        };


        const currentOrder =
            statusOrder[currentStatus] || 0;


        // --------------------------------------------------------
        // CREATE TIMELINE
        // --------------------------------------------------------

        timeline.innerHTML = `

            <div class="space-y-0">

                ${steps.map((step, index) => {

                    const stepOrder =
                        index + 1;

                    const completed =
                        currentOrder >= stepOrder;

                    const active =
                        currentOrder === stepOrder;

                    let circleClass =
                        "border-2 border-slate-300 bg-white text-slate-500";

                    let titleClass =
                        "text-slate-400";

                    if (completed) {

                        circleClass =
                            "bg-green-600 text-white border-2 border-green-600";

                        titleClass =
                            "text-slate-900";

                    }

                    if (active) {

                        circleClass =
                            "bg-blue-600 text-white border-2 border-blue-600";

                        titleClass =
                            "text-blue-700";

                    }


                    return `

                        <div class="flex items-start">

                            <div class="flex flex-col items-center mr-3">

                                <div
                                    class="w-9 h-9 rounded-full flex items-center justify-center font-bold text-sm ${circleClass}"
                                >
                                    ${stepOrder}
                                </div>

                                ${
                                    index < steps.length - 1
                                    ? `
                                        <div
                                            class="w-0.5 h-10 ${
                                                completed
                                                ? "bg-green-500"
                                                : "bg-slate-200"
                                            }"
                                        ></div>
                                    `
                                    : ""
                                }

                            </div>


                            <div class="pt-1 pb-5">

                                <div
                                    class="font-bold text-sm ${titleClass}"
                                >
                                    ${step.title}
                                </div>

                                <div
                                    class="text-xs text-slate-400 mt-1"
                                >
                                    ${step.subtitle}
                                </div>

                            </div>

                        </div>

                    `;

                }).join("")}

            </div>


            <div class="mt-2 pt-3 border-t border-slate-100 text-xs text-slate-500">

                🚑 Team:
                <span class="font-semibold text-slate-700">
                    ${mission.teamId}
                </span>

                ${
                    mission.etaMinutes
                    ? `
                        &nbsp; • &nbsp;
                        ETA:
                        <span class="font-semibold">
                            ${mission.etaMinutes} min
                        </span>
                    `
                    : ""
                }

            </div>

        `;


    } catch (error) {

        console.error(
            "❌ Authority mission progress error:",
            error
        );

        timeline.innerHTML = `

            <div class="text-sm text-red-500 text-center">
                Unable to load mission progress.
            </div>

        `;

    }

}

