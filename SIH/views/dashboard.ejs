   <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="https://unpkg.com/leaflet.heat@0.2.0/dist/leaflet-heat.js"></script>


<script>
    var selectedIncident = null;
/* ============================================================
   INCIDENT DATA
============================================================ */
const incidents = {};
let incidentMarkers = {};
let currentIncidentId = null;

// =========================================================
// RELIEF TEAMS
// =========================================================

let teams = [];

// =========================================================
// LOAD RELIEF TEAMS
// =========================================================

async function loadTeams() {

    try {

        const response =
            await fetch("/api/teams");

        if (!response.ok) {

            throw new Error(
                "Failed to load teams"
            );

        }

        const data =
            await response.json();

        console.log(
            "✅ Relief teams loaded:",
            data
        );


        // Handle either:
        // [ team, team, team ]
        // OR
        // { teams: [...] }

        const teamData =
            Array.isArray(data)
                ? data
                : data.teams || [];


        teams =
            teamData.map(team => ({

                id:
                    team.teamId,

                name:
                    team.name,

                organization:
                    team.organization,

                lat:
                    Number(team.lat || 0),

                lng:
                    Number(team.lng || 0),

                status:
                    team.status,

                load:
                    Number(team.load || 0),

                capabilities:
                    team.capabilities || []

            }));


        console.log(
            "✅ Teams available:",
            teams
        );


    } catch (error) {

        console.error(
            "❌ Failed to load relief teams:",
            error
        );

    }

}
/* ============================================================
   MAP
============================================================ */

const map = L.map("map", {
    zoomControl: true,
    attributionControl: true
}).setView(
    [20.28010, 85.81020],
    13
);
    L.tileLayer(
        "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",
        {
            maxZoom: 19,
            attribution:
                '&copy; OpenStreetMap contributors'
        }
    ).addTo(map);

    // ============================================================
// HEATMAP LAYER
// ============================================================

let heatLayer = null;
let heatmapVisible = true;

function updateHeatmap() {

    if (!heatmapVisible) return;

    // Purana heat layer hatao
    if (heatLayer) {
        map.removeLayer(heatLayer);
    }

    const heatPoints = Object.values(incidents).map(incident => {

        // Severity ke hisaab se base intensity
        let intensity = 0.3;

        if (incident.severity === "High / Critical") {
            intensity = 1.0;
        } else if (incident.severity === "Medium") {
            intensity = 0.6;
        } else {
            intensity = 0.3;
        }

        // People count se intensity thoda aur badhao (max +0.5)
        intensity += Math.min(incident.people / 50, 0.5);

        return [incident.lat, incident.lng, intensity];
    });
    const zoom = map.getZoom();
    const scale = Math.pow(1.5, zoom - 13);
      const cappedScale = Math.min(scale, 3);

    heatLayer = L.heatLayer(heatPoints, {
         radius: 35 * cappedScale,   // scale is multiplied for dynamic heat map
        blur: 25 *cappedScale,
        maxZoom: 15,
        max: 1.5,
        gradient: {
            0.2: '#2563eb',   // blue = low
            0.4: '#eab308',   // yellow = medium
            0.6: '#f97316',   // orange = high
            1.0: '#dc2626'    // red = critical/dense
        }
    }).addTo(map);
}
// for updating the heatmap 
map.on('zoomend', () => {
    if (heatmapVisible) updateHeatmap();
});

    /* ============================================================
       CUSTOM MARKERS
    ============================================================ */

    function incidentIcon() {

        return L.divIcon({

            className: "",

            html: `
                <div style="
                    width:32px;
                    height:32px;
                    background:#ef4444;
                    border:4px solid white;
                    border-radius:50%;
                    box-shadow:0 2px 8px rgba(0,0,0,.35);
                    display:flex;
                    align-items:center;
                    justify-content:center;
                    color:white;
                    font-size:15px;
                    font-weight:bold;
                ">
                    !
                </div>
            `,

            iconSize: [32, 32],
            iconAnchor: [16, 16]

        });

    }
async function loadIncidents() {

    try {

        // ============================================================
        // LOAD DEDUPLICATED INCIDENTS
        // ============================================================

        const response =
            await fetch("/api/reports/grouped");

        const data =
            await response.json();

        console.log(
            "Grouped incidents from database:",
            data
        );


        if (!data.success) {

            console.error(
                "Failed to load grouped reports"
            );

            return;
        }


        // ============================================================
        // REMOVE OLD MAP MARKERS
        // ============================================================

        Object.values(incidentMarkers)
            .forEach(marker => {

                map.removeLayer(marker);

            });

        incidentMarkers = {};


        // ============================================================
        // CLEAR OLD INCIDENT DATA
        // ============================================================

        Object.keys(incidents)
            .forEach(key => {

                delete incidents[key];

            });


        document.getElementById(
            "incidentList"
        ).innerHTML = "";


        // ============================================================
        // CREATE ONE INCIDENT PER GROUP
        // ============================================================

        data.groups.forEach(
            (group, index) => {


const incident = {

    id:
        group.groupId,

    displayId:
        index + 1,

    type:
        group.incidentType,

    severity:
        group.urgency,


    // =================================================
    // TOTAL PEOPLE FROM ALL REPORTS
    // =================================================

    people:
        group.peopleCount || 0,


    // =================================================
    // NUMBER OF CITIZEN REPORTS
    // =================================================

    reportCount:
        group.reportCount || 1,


    // =================================================
    // STATUS
    // =================================================

   status:
    group.status ||
    "ACTIVE",


    // =================================================
    // LOCATION
    // =================================================

    lat:
        group.latitude,

    lng:
        group.longitude,


    // =================================================
    // KEEP ALL ORIGINAL REPORTS
    // =================================================

    reports:
        group.reports || [],


    // =================================================
    // KEEP ALL PHOTOS
    // =================================================

    photos:
        (group.reports || [])
            .filter(report =>
                report.photo
            )
            .map(report =>
                report.photo
            ),


    // =================================================
    // KEEP ALL DESCRIPTIONS
    // =================================================

    descriptions:
        (group.reports || [])
            .map(report =>
                report.description || ""
            ),


    // =================================================
    // AI SEVERITY
    // =================================================

    severityScore:
        Math.max(
            0,
            ...(group.reports || [])
                .map(report =>
                    Number(report.severityScore) || 0
                )
        ),


    // =================================================
    // AI SEVERITY LEVEL
    // =================================================

    severityLevel:
        (() => {

            const priority = {

                "Low": 1,

                "Moderate": 2,

                "Medium": 3,

                "High": 4,

                "Severe": 5,

                "Critical": 6

            };


            const reports =
                group.reports || [];


            if (!reports.length) {

                return "Unknown";

            }


            return reports
                .filter(report =>
                    report.severityLevel
                )
                .sort(
                    (a, b) =>
                        (priority[b.severityLevel] || 0) -
                        (priority[a.severityLevel] || 0)
                )[0]
                ?.severityLevel || "Unknown";

        })()

};

                // =====================================================
                // STORE GROUPED INCIDENT
                // =====================================================

                incidents[incident.id] =
                    incident;


                // =====================================================
                // CREATE MAP MARKER
                // =====================================================

                const marker =
                    L.marker(
                        [
                            incident.lat,
                            incident.lng
                        ],
                        {
                            icon:
                                incidentIcon()
                        }
                    ).addTo(map);


                // =====================================================
                // MAP POPUP
                // =====================================================

                marker.bindPopup(`

                    <div
                        style="min-width:180px"
                    >

                        <strong>
                            SOS-${incident.displayId}
                        </strong>

                        <br>

                        ${incident.type}

                        <br>

                        Severity:
                        ${incident.severity}

                        <br>

                        Reports:
                        ${incident.reportCount}

                        <br>

                        People affected:
                        ${incident.people}

                        <br>

                        Status:
                        ${incident.status}

                    </div>

                `);


                incidentMarkers[incident.id] =
                    marker;


                // =====================================================
                // SEVERITY BADGE
                // =====================================================

                // =====================================================
// AI SEVERITY BADGE
// =====================================================

const severityClass =

    incident.severityLevel === "Critical"

        ? "badge-critical"

        : incident.severityLevel === "Severe"

            ? "badge-critical"

            : incident.severityLevel === "High"

                ? "badge-high"

                : incident.severityLevel === "Medium"

                    ? "badge-medium"

                    : incident.severityLevel === "Moderate"

                        ? "badge-medium"

                        : "badge-low";
                // =====================================================
                // CREATE INCIDENT CARD
                // =====================================================

                const card =
                    document.createElement(
                        "div"
                    );


                card.className =
                    "incident-card";


                card.dataset.incident =
                    incident.id;
card.onclick = () => {

    document
        .querySelectorAll(".incident-card")
        .forEach(item => item.classList.remove("selected"));

    card.classList.add("selected");
    selectedIncident = incident;
    currentIncidentId = incident.id;

    console.log("✅ Incident selected:", selectedIncident);

    // Update the full details panel on single click
    selectIncident(incident.id);
};

card.ondblclick = () => {

    // DOUBLE CLICK = OPEN FULL DETAILS

    window.open(
        `/api/reports/incident-reports?id=${encodeURIComponent(incident.id)}`,
        "_blank"
    );

};

                card.innerHTML = `

                    <div
                        class="flex justify-between items-start"
                    >

                        <div>

                            <div
                                class="text-[10px] font-bold text-red-600"
                            >
