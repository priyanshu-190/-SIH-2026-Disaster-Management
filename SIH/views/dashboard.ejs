let selectedShelterForAssignment = null;

function selectShelterForAssignment(shelter, button) {

    selectedShelterForAssignment = shelter;


    // Remove previous selection

    document
        .querySelectorAll(
            "#shelterAssignmentList button"
        )
        .forEach(btn => {

            btn.classList.remove(
                "border-blue-600",
                "bg-blue-50"
            );

        });


    // Highlight selected shelter

    button.classList.add(
        "border-blue-600",
        "bg-blue-50"
    );


    // Show selected shelter

    const selectedInfo =
        document.getElementById(
            "selectedShelterInfo"
        );

    selectedInfo.innerHTML = `

        <div class="font-semibold text-blue-800">
            Selected Shelter:
            ${shelter.name}
        </div>

        <div class="text-xs text-blue-700 mt-1">
            ${shelter.availableCapacity}
            beds currently available
        </div>

    `;

    selectedInfo.classList.remove("hidden");


    // Set maximum number of people

    const peopleInput =
        document.getElementById(
            "shelterPeopleCount"
        );

    peopleInput.value = "";

    peopleInput.max =
        shelter.availableCapacity;


    document.getElementById(
        "shelterCapacityHint"
    ).textContent =
        `Maximum you can assign:
        ${shelter.availableCapacity} people`;

}
// ============================================================
// CONFIRM SHELTER ASSIGNMENT
// ============================================================

document
    .getElementById("confirmShelterAssignment")
    .addEventListener("click", async function () {

        // --------------------------------------------------------
        // CHECK SHELTER SELECTION
        // --------------------------------------------------------

        if (!selectedShelterForAssignment) {

            alert("Please select a shelter first.");

            return;
        }


        // --------------------------------------------------------
        // GET NUMBER OF PEOPLE
        // --------------------------------------------------------

        const people =
            Number(
                document.getElementById(
                    "shelterPeopleCount"
                ).value
            );


        // --------------------------------------------------------
        // VALIDATE NUMBER
        // --------------------------------------------------------

        if (
            !Number.isInteger(people) ||
            people <= 0
        ) {

            alert(
                "Please enter a valid number of people."
            );

            return;
        }


        // --------------------------------------------------------
        // CHECK CAPACITY
        // --------------------------------------------------------

        if (
            people >
            Number(
                selectedShelterForAssignment
                    .availableCapacity
            )
        ) {

            alert(
                `Only ${selectedShelterForAssignment.availableCapacity} beds are available.`
            );

            return;
        }


        // --------------------------------------------------------
        // DISABLE BUTTON
        // --------------------------------------------------------

        this.disabled = true;

        this.textContent =
            "Assigning...";


        try {

            // ----------------------------------------------------
            // SEND ASSIGNMENT TO SERVER
            // ----------------------------------------------------

            const response =
                await fetch(
                    `/api/shelters/${selectedShelterForAssignment._id}/assign`,
                    {
                        method: "POST",

                        headers: {
                            "Content-Type":
                                "application/json"
                        },

                        body: JSON.stringify({
                            people: people
                        })
                    }
                );


            const result =
                await response.json();


            // ----------------------------------------------------
            // HANDLE ERROR
            // ----------------------------------------------------

            if (
                !response.ok ||
                !result.success
            ) {

                throw new Error(
                    result.message ||
                    "Shelter assignment failed"
                );

            }


            // ----------------------------------------------------
            // SUCCESS
            // ----------------------------------------------------

            alert(
                `${people} people assigned to ${result.shelter.name} successfully.`
            );


            // ----------------------------------------------------
            // CLOSE MODAL
            // ----------------------------------------------------

            document
                .getElementById(
                    "shelterAssignmentModal"
                )
                .classList.add("hidden");


            // ----------------------------------------------------
            // REFRESH SHELTER DATA
            // ----------------------------------------------------

            await loadShelters();


            // Reset selection

            selectedShelterForAssignment =
                null;


        } catch (error) {

            console.error(
                "Shelter assignment error:",
                error
            );


            alert(
                error.message ||
                "Failed to assign shelter."
            );


        } finally {

            this.disabled = false;

            this.textContent =
                "Assign People";

        }

    });
