function openShelterAssignment() {

    if (!currentIncident) {

        alert("Please select an incident first.");

        return;
    }


    const modal =
        document.getElementById(
            "shelterAssignmentModal"
        );

    const incidentInfo =
        document.getElementById(
            "shelterAssignmentIncidentInfo"
        );

    const shelterList =
        document.getElementById(
            "shelterAssignmentList"
        );


    // Show incident information

    incidentInfo.innerHTML = `

        <div class="font-semibold text-slate-800">
            ${currentIncident.type || "Incident"}
        </div>

        <div class="text-xs text-slate-500 mt-1">
            📍 ${Number(currentIncident.lat).toFixed(5)},
            ${Number(currentIncident.lng).toFixed(5)}
        </div>

        <div class="text-xs text-slate-500 mt-1">
            👥 ${currentIncident.people || 0}
            people affected
        </div>

    `;


    // ========================================================
    // FIND NEARBY AVAILABLE SHELTERS
    // ========================================================

    const nearbyShelters =
        allShelters
            .filter(shelter =>
                shelter.status === "available" &&
                Number(shelter.availableCapacity || 0) > 0
            )
            .map(shelter => {

                const distance =
                    getDistanceKm(
                        Number(currentIncident.lat),
                        Number(currentIncident.lng),
                        Number(shelter.location.latitude),
                        Number(shelter.location.longitude)
                    );

                return {
                    ...shelter,
                    distance
                };

            })
            .sort((a, b) =>
                a.distance - b.distance
            );


    shelterList.innerHTML = "";


    // ========================================================
    // NO AVAILABLE SHELTERS
    // ========================================================

    if (nearbyShelters.length === 0) {

        shelterList.innerHTML = `
            <div class="text-sm text-slate-500 text-center p-4">
                No shelters with available beds found.
            </div>
        `;

        modal.classList.remove("hidden");

        return;
    }


    // ========================================================
    // DISPLAY SHELTERS
    // ========================================================

    nearbyShelters.forEach(shelter => {

        const button =
            document.createElement("button");

        button.type = "button";

        button.className =
            "w-full text-left p-3 rounded-lg border border-slate-200 hover:border-blue-500 hover:bg-blue-50 mb-2";


        button.innerHTML = `

            <div class="flex justify-between">

                <div>

                    <div class="font-semibold text-slate-800">
                        🏠 ${shelter.name}
                    </div>

                    <div class="text-xs text-slate-500">
                        ${shelter.address}
                    </div>

                    <div class="text-xs text-slate-500 mt-1">
                        📍 ${shelter.distance.toFixed(1)} km away
                    </div>

                </div>

                <div class="text-right">

                    <div class="text-green-600 font-bold">
                        ${shelter.availableCapacity}
                    </div>

                    <div class="text-[10px] text-slate-500">
                        beds available
                    </div>

                </div>

            </div>

        `;


        button.addEventListener(
            "click",
            function () {

                selectShelterForAssignment(
                    shelter,
                    button
                );

            }
        );


        shelterList.appendChild(button);

    });


    modal.classList.remove("hidden");
}
