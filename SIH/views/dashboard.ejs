/* =========================================================
   DISPATCH RELIEF TEAM
   ========================================================= */

const dispatchTeamBtn = document.getElementById("dispatchTeamBtn");
const dispatchTeamModal = document.getElementById("dispatchTeamModal");
const closeDispatchModal = document.getElementById("closeDispatchModal");
const cancelDispatchBtn = document.getElementById("cancelDispatchBtn");
const confirmDispatchBtn = document.getElementById("confirmDispatchBtn");
const dispatchTeamSelect = document.getElementById("dispatchTeamSelect");
const dispatchInstructions = document.getElementById("dispatchInstructions");

function getTeamCapabilityMatches(incident, team) {
    const incidentCapabilities = Array.isArray(incident?.capabilities)
        ? incident.capabilities.map(String)
        : [];

    const teamCapabilities = Array.isArray(team?.capabilities)
        ? team.capabilities.map(String)
        : [];

    if (!incidentCapabilities.length || !teamCapabilities.length) return 0;

    return incidentCapabilities.filter(capability =>
        teamCapabilities.some(teamCap =>
            String(teamCap).toLowerCase() === String(capability).toLowerCase()
        )
    ).length;
}

function getTeamOperationalScore(incident, team) {
    if (!incident || !team) return -Infinity;

    const distance = getDistanceKm(
        Number(incident.lat),
        Number(incident.lng),
        Number(team.lat),
        Number(team.lng)
    );

    const matches = getTeamCapabilityMatches(incident, team);
    const load = Number(team.load || 0);

    // Operational recommendation for now.
    // Later the AI model can replace this score without changing the UI.
    let score = 100;
    score -= Math.min(distance * 5, 50);
    score += matches * 15;
    score -= load * 0.25;

    if (String(team.status).toUpperCase() !== "AVAILABLE") {
        score -= 1000;
    }

    return score;
}

function populateDispatchTeams() {

    if (!dispatchTeamSelect) return;

    dispatchTeamSelect.innerHTML = `
        <option value="">Select a team...</option>
    `;

    if (!selectedIncident) return;

    if (!Array.isArray(teams) || teams.length === 0) {
        const option = document.createElement("option");
        option.value = "";
        option.textContent = "No relief teams available";
        option.disabled = true;
        dispatchTeamSelect.appendChild(option);
        return;
    }

    const rankedTeams = teams
        .map(team => {
            const distance = getDistanceKm(
                Number(selectedIncident.lat),
                Number(selectedIncident.lng),
                Number(team.lat),
                Number(team.lng)
            );

            const matches = getTeamCapabilityMatches(selectedIncident, team);
            const score = getTeamOperationalScore(selectedIncident, team);

            return { team, distance, matches, score };
        })
        .sort((a, b) => b.score - a.score);

    rankedTeams.forEach(({ team, distance, matches }, index) => {

        const option = document.createElement("option");
        option.value = team.id;

        const organization = team.organization || "Response Team";
        const status = String(team.status || "UNKNOWN").toUpperCase();
        const recommendation = index === 0 && status === "AVAILABLE"
            ? " ⭐ RECOMMENDED"
            : "";

        option.textContent =
            `${organization} — ${team.name || team.id} — ${distance.toFixed(1)} km — ${matches} capability match${matches === 1 ? "" : "es"}${recommendation}`;

        if (status !== "AVAILABLE") {
            option.disabled = true;
            option.textContent += " — BUSY";
        }

        dispatchTeamSelect.appendChild(option);
    });
}

function openDispatchModal() {

    if (!selectedIncident) {
        alert("Please select an incident first.");
        return;
    }

    const score = Number(selectedIncident.severityScore || 0);
    const level = selectedIncident.severityLevel || selectedIncident.severity || "Unknown";
    const people = Number(selectedIncident.people || 0);

    const severityElement = document.getElementById("dispatchAiSeverity");
    const peopleElement = document.getElementById("dispatchPeople");

    if (severityElement) {
        severityElement.textContent = `${level} — ${score.toFixed(2)} / 100`;
    }

    if (peopleElement) {
        peopleElement.textContent = people;
    }

    if (dispatchInstructions) {
        dispatchInstructions.value = "";
    }

    populateDispatchTeams();
    dispatchTeamModal.classList.remove("hidden");
}

if (dispatchTeamBtn && dispatchTeamModal) {
    dispatchTeamBtn.addEventListener("click", openDispatchModal);
}

function closeDispatchModalNow() {
    if (dispatchTeamModal) {
        dispatchTeamModal.classList.add("hidden");
    }
}

if (closeDispatchModal) {
    closeDispatchModal.addEventListener("click", closeDispatchModalNow);
}

if (cancelDispatchBtn) {
    cancelDispatchBtn.addEventListener("click", closeDispatchModalNow);
}

if (confirmDispatchBtn) {

    confirmDispatchBtn.addEventListener("click", async function () {

        if (!selectedIncident) {
            alert("Please select an incident first.");
            return;
        }

        if (!dispatchTeamSelect) {
            alert("Team selector is unavailable.");
            return;
        }

        const selectedTeamId = dispatchTeamSelect.value;

        if (!selectedTeamId) {
            alert("Please select a relief team.");
            return;
        }

        const team = teams.find(t => String(t.id) === String(selectedTeamId));

        if (!team) {
            alert("Selected team could not be found.");
            return;
        }

        if (String(team.status).toUpperCase() !== "AVAILABLE") {
            alert("This team is no longer available.");
            return;
        }

        const distance = getDistanceKm(
            Number(selectedIncident.lat),
            Number(selectedIncident.lng),
            Number(team.lat),
            Number(team.lng)
        );

        const matches = getTeamCapabilityMatches(selectedIncident, team);

        const etaMinutes = Math.max(
            1,
            Math.ceil((distance / 40) * 60)
        );

        const originalText = this.textContent;
        
        this.disabled = true;
        this.textContent = "🚑 Dispatching...";

        try {
console.log("🚑 SELECTED TEAM:", team);
console.log("🚑 TEAM ID BEING SENT:", team.id);
            const response = await fetch("/api/missions/dispatch", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify({
                    incidentId: selectedIncident.id,
                    teamId: team.id,
                    etaMinutes,
                    matchScore: Math.min(100, Math.round(
                        getTeamOperationalScore(selectedIncident, team)
                    )),
                    distanceKm: Number(distance.toFixed(2)),
                    instructions: dispatchInstructions
                        ? dispatchInstructions.value.trim()
                        : "",
                    incident: {
                        title: selectedIncident.type || "Disaster Incident",
                        type: selectedIncident.type || "Other",
                        priority:
                            selectedIncident.severityLevel === "Critical"
                                ? "CRITICAL"
                                : selectedIncident.severityLevel === "Severe" || selectedIncident.severityLevel === "High"
                                    ? "HIGH"
                                    : selectedIncident.severityLevel === "Medium" || selectedIncident.severityLevel === "Moderate"
                                        ? "MEDIUM"
                                        : "LOW",
                        description: (selectedIncident.descriptions || []).join(" "),
                        lat: Number(selectedIncident.lat),
                        lng: Number(selectedIncident.lng),
                        people: Number(selectedIncident.people || 0),
                        capabilities: selectedIncident.capabilities || []
                    }
                })
            });

            const result = await response.json();

            if (!response.ok) {
                throw new Error(result.message || "Dispatch failed");
            }

            // Update local state immediately.
            team.status = "BUSY";
            if (result.team && result.team.load !== undefined) {
                team.load = Number(result.team.load);
            }

            if (dispatchTeamModal) {
                dispatchTeamModal.classList.add("hidden");
            }

            alert(
                `🚑 Team dispatched successfully!\n\n` +
                `Team: ${team.name || team.id}\n` +
                `Organization: ${team.organization || "Response Team"}\n` +
                `Incident: ${selectedIncident.id}\n` +
                `Distance: ${distance.toFixed(1)} km\n` +
                `ETA: ${etaMinutes} min`
            );

            console.log("🚨 DISPATCH SUCCESS", result);

        } catch (error) {

            console.error("❌ Dispatch failed:", error);
            alert("Dispatch failed: " + error.message);

        } finally {
            this.disabled = false;
            this.textContent = originalText || "🚑 Dispatch Order";
        }
    });
}

