function goToAdjacentIncident(direction) {

    const ids = Object.keys(incidents);

    if (ids.length === 0) return;

    let currentIndex = ids.indexOf(String(currentIncidentId));

    if (currentIndex === -1) currentIndex = 0;

    let newIndex = currentIndex + direction;

    // Wraparound (last se first, first se last)
    if (newIndex < 0) newIndex = ids.length - 1;
    if (newIndex >= ids.length) newIndex = 0;

    selectIncident(ids[newIndex]);

}


