<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Authority Dashboard | Disaster Relief Hub</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="/socket.io/socket.io.js"></script>
    <!-- Leaflet CSS -->
    <link
        rel="stylesheet"
        href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
    />
 

    <style>
        
        * {
            box-sizing: border-box;
        }

        html,
        body {
            width: 100%;
            min-height: 100%;
            margin: 0;
            overflow-x: hidden;
            overflow-y: auto;
            font-family: Inter, ui-sans-serif, system-ui, -apple-system,
                BlinkMacSystemFont, "Segoe UI", sans-serif;
            background: #f1f5f9;
        }

        /* Main dashboard */
     .dashboard {
    width: 100%;
    max-width: 100%;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
}

        /* Header */
       .topbar {
    height: 74px;
    min-height: 74px;
    background: #5a4bda;
}

        /* Main area */
      .main-area {
    min-height: calc(100vh - 74px);
    height: auto;
    padding: 13px 24px 60px;
    overflow: visible;
}

        /* Stats */
        .stats-grid {
            height: 92px;
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 12px;
            margin-bottom: 14px;
        }

        .stat-card {
            background: white;
            border: 1px solid #e5e7eb;
            border-radius: 11px;
            box-shadow: 0 2px 7px rgba(15, 23, 42, 0.07);
            display: flex;
            align-items: center;
            padding: 14px 16px;
            min-width: 0;
        }

        .stat-icon {
            width: 46px;
            height: 46px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        /* Main columns */
        .content-grid {
    height: calc(100vh - 217px);
    min-height: 630px;   
    display: grid;
    grid-template-columns: 273px minmax(0, 1fr) 315px;
    gap: 12px;
}
        .panel {
            background: white;
            border: 1px solid #e5e7eb;
            border-radius: 11px;
            box-shadow: 0 2px 7px rgba(15, 23, 42, 0.06);
            min-height: 0;
            overflow: hidden;
        }

        .panel-header {
            height: 48px;
            padding: 0 14px;
            border-bottom: 1px solid #e5e7eb;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        /* for rotating button */
#refreshShelters {
    cursor: pointer;
    transition: color 0.2s ease;
}

#refreshShelters.refreshing {
    animation: shelterRefresh 0.5s linear;
}

@keyframes shelterRefresh {
    from {
        transform: rotate(0deg);
    }

    to {
        transform: rotate(360deg);
    }
}
        /* Incidents */
        .incidents-panel {
            display: flex;
            flex-direction: column;
        }

        .incident-list {
            flex: 1;
            padding: 10px;
            overflow: hidden;
        }

      

        .incident-card:hover {
            border-color: #93c5fd;
            background: #f8fbff;
        }

        .incident-card.selected {
            border-color: #ef4444;
            background: #fff7f7;
            box-shadow: 0 0 0 1px rgba(239, 68, 68, 0.1);
        }

       

        .incident-footer {
            padding: 9px 10px;
            border-top: 1px solid #e5e7eb;
        }

        /* Center */
        .center-column {
            min-width: 0;
            min-height: 0;
            height: 100%;
            display: block;
        }

        .map-panel {
            width: 100%;
            height: 100%;
            min-height: 0;
            display: flex;
            flex-direction: column;
        }

        .map-container {
            flex: 1;
            min-height: 0;
            position: relative;
        }

        #map {
            width: 100%;
            height: 100%;
            min-height: 0;
        }

        .map-legend {
            position: absolute;
            top: 9px;
            right: 10px;
            z-index: 500;
            background: rgba(255, 255, 255, 0.96);
            border-radius: 7px;
            padding: 7px 10px;
            font-size: 10px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
        }

        .legend-item {
            display: flex;
            align-items: center;
            gap: 5px;
            margin-bottom: 3px;
        }

        .legend-item:last-child {
            margin-bottom: 0;
        }

        .legend-dot {
            width: 9px;
            height: 9px;
            border-radius: 50%;
        }

        /* Details */
       .details-panel {
    width: 100%;
    min-height: 420px;
    margin-top: 12px;
    margin-bottom: 40px;
    scroll-margin-top: 12px;
    display: flex;
    flex-direction: column;
}

        .details-content {
            padding: 14px;
            min-height: 0;
        }

        .detail-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            border: 1px solid #e5e7eb;
            border-radius: 7px;
            overflow: hidden;
        }

        .detail-item {
            padding: 12px 14px;
            border-right: 1px solid #e5e7eb;
        }

        .detail-item:last-child {
            border-right: none;
        }

        .detail-label {
            font-size: 12px;
            color: #64748b;
            margin-bottom: 3px;
        }

        .detail-value {
            font-size: 15px;
            font-weight: 600;
            color: #1e293b;
        }

        .nearest-title {
            font-size: 13px;
            font-weight: 700;
            color: #334155;
            margin: 8px 0 5px;
        }

        .nearest-row {
            height: 38px;
            display: grid;
            grid-template-columns: 1fr 60px 100px;
            align-items: center;
            border: 1px solid #e5e7eb;
            border-bottom: none;
            padding: 0 12px;
            font-size: 12px;
        }

        .nearest-row:last-child {
            border-bottom: 1px solid #e5e7eb;
            border-radius: 0 0 6px 6px;
        }

        .details-content .text-\[9px\] {
            font-size: 12px !important;
        }

        .action-buttons {
            display: grid;
            grid-template-columns: 1fr 1.35fr 1.15fr;
            gap: 8px;
            margin-top: 8px;
        }

        .action-btn {
            height: 40px;
            border-radius: 6px;
            color: white;
            font-size: 12px;
            font-weight: 600;
            border: none;
            cursor: pointer;
            transition: transform 0.1s ease, opacity 0.1s ease;
        }

        .action-btn:hover {
            opacity: 0.9;
        }

        .action-btn:active {
            transform: scale(0.98);
        }

        /* Shelters */
        .shelters-panel {
            display: flex;
            flex-direction: column;
        }

        .shelter-list {
            padding: 9px;
            flex: 1;
            overflow: hidden;
        }

       

        .shelter-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 6px;
        }

        .shelter-body {
            display: flex;
            gap: 8px;
        }

        .shelter-image {
            width: 72px;
            height: 55px;
            border-radius: 6px;
            object-fit: cover;
            flex-shrink: 0;
        }

        .shelter-info {
            min-width: 0;
            flex: 1;
        }

       
        .progress-bar {
            height: 5px;
            width: 100%;
            background: #e5e7eb;
            border-radius: 10px;
            overflow: hidden;
            margin-top: 5px;
        }

        .progress-fill {
            height: 100%;
            background: #16a34a;
            border-radius: 10px;
        }

        .shelter-footer {
            border-top: 1px solid #e5e7eb;
            height: 35px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* Status badges */
        .badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 3px 6px;
            border-radius: 5px;
            font-size: 8px;
            font-weight: 700;
            text-transform: uppercase;
        }

        .badge-critical {
            background: #fee2e2;
            color: #dc2626;
        }

        .badge-high {
            background: #fef3c7;
            color: #d97706;
        }

        .badge-medium {
            background: #dbeafe;
            color: #2563eb;
        }

        .badge-low {
            background: #dcfce7;
            color: #16a34a;
        }

        .badge-active {
            background: #dcfce7;
            color: #15803d;
        }

        /* User */
        .user-box {
            height: 42px;
            padding: 4px 10px;
            border-radius: 7px;
            border: 1px solid rgba(255, 255, 255, 0.12);
            background: rgba(255, 255, 255, 0.06);
        }

        /* ============================================================
           LOGOUT BUTTON (moved out of the media query — this is the bug
           that was breaking the animation and sizing on desktop)
        ============================================================ */
        .Btn {
          --black: #000000;
          --ch-black: #141414;
          --eer-black: #1b1b1b;
          --night-rider: #2e2e2e;
          --white: #ffffff;
          --af-white: #f3f3f3;
          --ch-white: #e1e1e1;
          display: flex;
          align-items: center;
          justify-content: flex-start;
          width: 27px;
          height: 27px;
          border: none;
          border-radius: 5px;
          cursor: pointer;
          position: relative;
          overflow: hidden;
          transition-duration: .3s;
          box-shadow: 2px 2px 10px rgba(0, 0, 0, 0.199);
          background-color: var(--night-rider);
        }

        .sign {
          width: 100%;
          transition-duration: .3s;
          display: flex;
          align-items: center;
          justify-content: center;
        }

        .sign svg {
          width: 10px;
        }

        .sign svg path {
          fill: var(--af-white);
        }

        .text {
          position: absolute;
          right: 0%;
          width: 0%;
          opacity: 0;
          color: var(--af-white);
          font-size: 1.2em;
          font-weight: 600;
          transition-duration: .3s;
          white-space: nowrap;
        }

        .Btn:hover {
          width: 100px;
          border-radius: 5px;
          transition-duration: .3s;
        }

        .Btn:hover .sign {
          width: 30%;
          transition-duration: .3s;
          padding-left: 20px;
        }

        .Btn:hover .text {
          opacity: 1;
          width: 70%;
          transition-duration: .3s;
          padding-right: 10px;
        }

        .Btn:active {
          transform: translate(2px, 2px);
        }

        /* Responsive desktop */
        @media (max-width: 1200px) {

            .content-grid {
                grid-template-columns: 225px minmax(0, 1fr) 285px;
            }

            .stats-grid {
                gap: 8px;
            }

            .stat-card {
                padding: 10px;
            }

            .stat-icon {
                width: 40px;
                height: 40px;
            }
        }

        @media (max-width: 1000px) {

            .content-grid {
                grid-template-columns: 210px minmax(0, 1fr) 260px;
                gap: 8px;
            }

            .main-area {
                padding: 8px;
            }

            .stats-grid {
                margin-bottom: 8px;
            }

            .content-grid {
                height: calc(100vh - 188px);
                min-height: 460px;
            }

            .shelter-image {
                width: 60px;
                height: 48px;
            }
        }


        /* ============ FONT UPGRADE - INCIDENTS & SHELTERS ============ */

.panel-header span {
    font-size: 16px;      
    font-weight: 700;
}

.incident-card .text-\[10px\] {
    font-size: 14px !important;   
    font-weight: 700;
}

.incident-card .text-xs {
    font-size: 17px !important;  
    font-weight: 700;
}

.incident-bottom {
    font-size: 13px !important; 
}

.shelter-card .text-\[10px\] {
    font-size: 16px !important;   
    font-weight: 700;
}

.shelter-info-row {
    font-size: 13px !important;   
}

.badge {
    font-size: 12px;      
    padding: 5px 9px;
    font-weight: 700;
}
.incident-card {
    border: 1.5px solid #d1d5db !important;
    border-radius: 10px !important;
    padding: 12px !important;
    margin-bottom: 12px !important;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.06) !important;
}

.incident-card.selected {
    border-color: #ef4444 !important;
    border-width: 2px !important;
    box-shadow: 0 2px 6px rgba(239, 68, 68, 0.15) !important;
}
/* ============ CORRECT FIXES (real structure ke hisaab se) ============ */

/* Arrows - bigger & professional, real IDs use kiye */
#prevIncidentBtn, #nextIncidentBtn {
    font-size: 18px !important;
    font-weight: 700;
    width: 34px;
    height: 34px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    border: 1px solid #e2e8f0;
    background: #f8fafc;
    color: #475569;
    transition: all 0.15s ease;
}
#prevIncidentBtn:hover, #nextIncidentBtn:hover {
    background: #2563eb;
    color: #fff;
    border-color: #2563eb;
}

/* Type / Severity / People / Status - font upgrade */
.detail-label {
    font-size: 13px;
    font-weight: 600;
}
.detail-value {
    font-size: 19px;
    font-weight: 700;
}
.detail-item {
    padding: 16px 14px;
}

/* Nearest shelters row - real class .nearest-row use kiya, fixed height hataya */
.nearest-row {
    height: auto;
    min-height: 48px;
    grid-template-columns: 1fr 70px 150px;  /* last column wide taaki "150 seats available" na tute */
    font-size: 14px;
    padding: 10px 14px;
    gap: 8px;
}
.nearest-row > div {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* Extra bottom space fill karne ke liye */
.details-panel {
    min-height: 480px;
    display: flex;
    flex-direction: column;
}
.details-content {
    display: flex;
    flex-direction: column;
    flex: 1;              /* height:100% ki jagah - flex parent me yahi sahi hai */
    padding: 18px;
}
.action-buttons {
    margin-top: auto;   /* buttons ko neeche push karega, extra gap khatam */
    padding-top: 16px;
}

    </style>
    
</head>

<body>

<div class="dashboard">

    <!-- =========================================================
         TOP NAVBAR
    ========================================================== -->
    <header class="topbar px-5 flex items-center justify-between">

        <!-- Logo -->
        <div class="flex items-center gap-3">

            <div
                class="w-10 h-10 rounded-lg bg-white/10 border border-white/10
                       flex items-center justify-center"
            >
                <svg
                    class="w-6 h-6 text-white"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M12 3l8 4v5c0 5-3.5 8.5-8 9-4.5-.5-8-4-8-9V7l8-4z"
                    />
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M9.5 12l2 2 4-4"
                    />
                </svg>
            </div>

            <div>
                <div class="text-white font-bold text-base leading-tight">
                    Disaster Relief Hub
                </div>

                <div class="text-slate-300 text-[10px]">
                    Authority Dashboard
                </div>
            </div>

  <!-- User / Navigation / Logout -->

<div class="ml-auto flex items-center gap-2"></div>
    <!-- Past Incidents -->
    <a
        href="/past-incidents"
        class="px-4 py-2 rounded-lg bg-slate-700
               hover:bg-slate-600 text-white text-sm
               font-semibold transition"
    >
        📚 Past Incidents
    </a>

    <!-- Logout -->
    <button class="Btn" id="logoutBtn">
        <div class="sign">
            <svg viewBox="0 0 512 512">
                <path d="M377.9 105.9L500.7 228.7c7.2 7.2 11.3 17.1 11.3 27.3s-4.1 20.1-11.3 27.3L377.9 406.1c-6.4 6.4-15 9.9-24 9.9c-18.7 0-33.9-15.2-33.9-33.9l0-62.1-128 0c-17.7 0-32-14.3-32-32l0-64c0-17.7 14.3-32 32-32l128 0 0-62.1c0-18.7 15.2-32.1 33.9-32.1c9 0 17.6 3.6 24 9.9zM160 96L96 96c-17.7 0-32 14.3-32 32l0 256c0 53 43 96 96 96l64 0c17.7 0 32-14.3 32-32s-14.3-32-32-32l-64 0c-17.7 0-32-14.3-32-32L64 128c0-17.7 43-32 96-32l64 0c17.7 0 32 14.3 32 32s-14.3 32-32 32z"></path>
            </svg>
        </div>
        <div class="text">Logout</div>
    </button>

</div>      
            

    </header>


    <!-- =========================================================
         MAIN DASHBOARD
    ========================================================== -->
    <main class="main-area">

        <!-- =====================================================
       
     STATISTICS
====================================================== -->
<section class="stats-grid">

    <!-- Active Reports -->
    <div class="stat-card">

        <div class="stat-icon bg-red-50">
            <svg class="w-6 h-6 text-red-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v4m0 4h.01M10.3 3.5L2.6 17a2 2 0 001.7 3h15.4a2 2 0 001.7-3L13.7 3.5a2 2 0 00-3.4 0z" />
            </svg>
        </div>

        <div class="ml-3 min-w-0">
            <div class="text-[14px] font-semibold text-slate-500 tracking-wide">
                Active Reports
            </div>
            <div id="activeReports" class="text-2xl font-bold text-slate-800">
                --
            </div>
            <div class="text-[12px] text-slate-400">
                Live incidents
            </div>
        </div>

    </div>


    <!-- People -->
    <div class="stat-card">

        <div class="stat-icon bg-blue-50">
            <svg class="w-6 h-6 text-blue-600" fill="currentColor" viewBox="0 0 24 24">
                <path d="M16 11a4 4 0 10-3.9-5 4 4 0 003.9 5zM8 10a3 3 0 100-6 3 3 0 000 6zm8.5 3c-2.3 0-4.5 1.1-5.8 2.9A7.4 7.4 0 0010 15c-3.3 0-6 2.1-6 4.8V21h16v-1.2c0-2.7-2.1-4.8-5.5-4.8z" />
            </svg>
        </div>

        <div class="ml-3 min-w-0">
            <div class="text-[14px] font-semibold text-slate-500 tracking-wide">
                People Needing Help
            </div>
            <div id="peopleHelp" class="text-2xl font-bold text-slate-800">
                --
            </div>
            <div class="text-[12px] text-slate-400">
                Across all incidents
            </div>
        </div>

    </div>


    <!-- Shelter seats -->
    <div class="stat-card">

        <div class="stat-icon bg-green-50">
            <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 11l9-7 9 7" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 10v9h14v-9M9 19v-5h6v5" />
            </svg>
        </div>

        <div class="ml-3 min-w-0">
            <div class="text-[14px] font-semibold text-slate-500 tracking-wide">
                Available Shelter Seats
            </div>
            <div id="availableSeats" class="text-2xl font-bold text-slate-800">
                --
            </div>
            <div class="text-[12px] text-slate-400">
                Total available
            </div>
        </div>

    </div>


    <!-- Active shelters -->
    <div class="stat-card">

        <div class="stat-icon bg-purple-50">
            <svg class="w-6 h-6 text-purple-600" fill="currentColor" viewBox="0 0 24 24">
                <path d="M4 21V5a2 2 0 012-2h12a2 2 0 012 2v16h-5v-5h-6v5H4zm5-11h2V7H9v3zm4 0h2V7h-2v3z" />
            </svg>
        </div>

        <div class="ml-3 min-w-0">
            <div class="text-[14px] font-semibold text-slate-500 tracking-wide">
                Active Shelters
            </div>
            <div id="activeShelters" class="text-2xl font-bold text-slate-800">
                --
            </div>
            <div class="text-[12px] text-slate-400">
                Operational shelters
            </div>
        </div>

    </div>

</section>
        <!-- =====================================================
             THREE COLUMN CONTENT
        ====================================================== -->
        <section class="content-grid">


            <!-- =================================================
                 LEFT : INCIDENTS
            ================================================== -->
            <aside class="panel incidents-panel">

                <div class="panel-header">

                    <div class="flex items-center gap-2">

                        <svg
                            class="w-4 h-4 text-red-500"
                            fill="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                d="M12 2L1 21h22L12 2zm1
                                   14h-2v-2h2v2zm0-4h-2V8h2v4z"
                            />
                        </svg>

                        <span
                            class="text-xs font-bold text-slate-800"
                        >
                            Active Incidents
                        </span>

                    </div>

  

                </div>


                <div
                    id="incidentList"
                    class="incident-list"
                >
                </div>


                <div class="incident-footer">

                    <button
                        id="viewAllReports"
                        class="w-full h-8 border border-slate-200
                               rounded-md text-blue-600 text-[10px]
                               font-semibold hover:bg-blue-50 transition"
                    >
                        View All Reports 
                    </button>

                </div>

            </aside>



            <!-- =================================================
                 CENTER
            ================================================== -->
            <div class="center-column">


                <!-- ================= MAP ================= -->
                <section class="panel map-panel">

                  <div class="panel-header">

    <div class="flex items-center gap-2">
        <svg class="w-4 h-4 text-slate-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 18l-6 3V6l6-3 6 3 6-3v15l-6 3-6-3z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 3v15M15 6v15" />
        </svg>
        <span class="text-xs font-bold text-slate-800">
            Live Map
        </span>
    </div>


    <div class="flex items-center gap-3">

        <button
            id="toggleHeatmap"
            class="text-[9px] font-semibold px-2 py-1 rounded border border-slate-300 hover:bg-slate-50 text-slate-700"
        >
            🔥 Heatmap: ON
        </button>

