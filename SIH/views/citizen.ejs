<style>

.severity-gauge {

    position: relative;

    width: 330px;

    height: 235px;

    margin: 35px auto 0;

}


/* ============================================================
   GAUGE SEGMENTS
============================================================ */

.gauge-segment {

    position: absolute;

    width: 300px;

    height: 150px;

    left: 15px;

    top: 25px;

    border-radius: 300px 300px 0 0;

    transform-origin: 50% 100%;

}



/* ============================================================
   LABELS
============================================================ */

.severity-label {

    position: absolute;

    z-index: 20;

    font-size: 10px;

    font-weight: 900;

    letter-spacing: 0.04em;

    color: #1e293b;

    white-space: nowrap;

}


/* LOW */

.label-low {

    left: 3px;

    top: 130px;

    transform: rotate(-48deg);

}


/* MODERATE */

.label-moderate {

    left: 54px;

    top: 48px;

    transform: rotate(-25deg);

}


/* HIGH */

.label-high {

    left: 144px;

    top: 20px;

}


/* SEVERE */

.label-severe {

    right: 48px;

    top: 48px;

    transform: rotate(25deg);

}


/* CRITICAL */

.label-critical {

    right: 0;

    top: 130px;

    transform: rotate(48deg);

}


/* ============================================================
   NEEDLE
============================================================ */

.severity-needle {

    position: absolute;

    z-index: 30;

    width: 5px;

    height: 105px;

    left: 50%;

    bottom: 55px;

    transform-origin: 50% 100%;

    transform:
        translateX(-50%)
        rotate(-90deg);

    background: #0f172a;

    border-radius: 999px;

    transition:
        transform 1s cubic-bezier(.22,1,.36,1);

}


/* ============================================================
   NEEDLE CENTER
============================================================ */

.severity-center {

    position: absolute;

    z-index: 40;

    width: 18px;

    height: 18px;

    left: 50%;

    bottom: 47px;

    transform: translateX(-50%);

    background: #0f172a;

    border: 4px solid white;

    border-radius: 50%;

    box-shadow:
        0 2px 6px rgba(0,0,0,.25);

}


/* ============================================================
   SCORE
============================================================ */

.severity-score-box {

    position: absolute;

    z-index: 50;

    left: 50%;

    bottom: 5px;

    transform: translateX(-50%);

    text-align: center;

}


.severity-score {

    font-size: 34px;

    font-weight: 900;

    line-height: 1;

    color: #0f172a;

}


.severity-score-max {

    margin-top: 3px;

    font-size: 11px;

    font-weight: 700;

    color: #94a3b8;

}

</style>


