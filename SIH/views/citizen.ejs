    <style>

        html {
            scroll-behavior: smooth;
        }

        body {
            margin: 0;
            overflow-x: hidden;
        }

        /* Map */
        #map {
            width: 100%;
            height: 100%;
            min-height: 420px;
        }

        /* Tablet */
        @media (max-width: 768px) {

            #map {
                min-height: 360px;
            }

        }

        /* Phone */
        @media (max-width: 640px) {

            #map {
                min-height: 320px;
            }

        }


        /* Incident button animation */
        .incident-btn {
            transition: all 0.2s ease;
        }

        .incident-btn:hover {
            transform: translateY(-1px);
            border-color: #2563eb;
            background: #eff6ff;
        }

        .incident-btn.active {
            border-color: #2563eb;
            background: #eff6ff;
            color: #1d4ed8;
            box-shadow:
                0 0 0 2px rgba(37, 99, 235, 0.12);
        }


        /* Urgency buttons */
        .urgency-btn {
            transition: all 0.2s ease;
        }

        .urgency-btn.active {
            transform: scale(1.02);
            box-shadow:
                0 0 0 3px rgba(0, 0, 0, 0.08);
        }

        /* ============================================================
   MOVING ALERT BANNER (marquee)
============================================================ */

/* ============================================================
   MOVING ALERT BANNER (marquee) — fixed height + severity badge
============================================================ */

.alert-ticker {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 32px;
    max-height: 32px;
    overflow: hidden;
    border-radius: 9999px;
    padding: 0 4px 0 12px;
    width: 100%;
    min-width: 0;      /* 👈 ye line flexbox growth bug fix karti hai */
    flex-shrink: 0;
}

.alert-severity-badge {
    flex-shrink: 0;
    font-size: 9px;
    font-weight: 800;
    text-transform: uppercase;
    padding: 3px 8px;
    border-radius: 9999px;
    white-space: nowrap;
}

.alert-ticker-viewport {
    flex: 1;
    min-width: 0;      /* 👈 ye bhi zaroori hai */
    overflow: hidden;
    height: 100%;
    display: flex;
    align-items: center;
}

.alert-ticker-track {
    display: inline-block;
    white-space: nowrap;
    padding-left: 100%;
    animation: tickerScroll 15s linear infinite;
}

.alert-ticker:hover .alert-ticker-track {
    animation-play-state: paused;
}

@keyframes tickerScroll {
    0% {
        transform: translateX(0%);
    }
    100% {
        transform: translateX(-100%);
    }
}

        /* Trapped buttons */
        .trapped-btn {
            transition: all 0.2s ease;
        }

        .trapped-btn.active {
            background: #dc2626;
            color: white;
            border-color: #dc2626;
        }


        /* Leaflet controls */
        .leaflet-control-zoom {
            border: none !important;
            box-shadow:
                0 2px 8px rgba(0, 0, 0, 0.2) !important;
        }

        .leaflet-control-zoom a {
            width: 38px !important;
            height: 38px !important;
            line-height: 38px !important;
            font-size: 22px !important;
        }


        /* Prevent map instruction from overflowing */
        .map-instruction {
            max-width: calc(100% - 24px);
            text-align: center;
        }

    </style>

</head>


