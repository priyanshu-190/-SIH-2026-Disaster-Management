let userAlertLat = null;
let userAlertLng = null;

function renderAlert(alert) {
    const colors = {
        Low: "bg-blue-100 text-blue-800 border-blue-200",
        Medium: "bg-amber-100 text-amber-800 border-amber-200",
        High: "bg-orange-100 text-orange-800 border-orange-200",
        Critical: "bg-red-100 text-red-800 border-red-200"
    };

    const badgeColors = {
        Low: "bg-blue-600 text-white",
        Medium: "bg-amber-600 text-white",
        High: "bg-orange-600 text-white",
        Critical: "bg-red-600 text-white"
    };

    // Chahe kitna bhi lamba text ho, banner ki height fix rahegi
    const shortText = `⚠️ ${alert.event}: ${alert.description.slice(0, 150)}`;

    return `
        <div class="alert-ticker ${colors[alert.severity]} border">

            <span class="alert-severity-badge ${badgeColors[alert.severity]}">
                ${alert.severity}
            </span>

            <div class="alert-ticker-viewport">
                <div class="alert-ticker-track text-xs lg:text-sm font-medium">
                    ${shortText}
                </div>
            </div>

        </div>
    `;
}
async function loadAlertsForCurrentLocation() {

    if (userAlertLat === null || userAlertLng === null) return;

    try {

     
        const useDummy = true;   

        let alerts;

        if (useDummy) {
            alerts = [{
                event: "Heavy Rain Warning",
                description: "Heavy to very heavy rainfall expected over the next 24 hours in your area. Residents near low-lying areas should stay alert.",
                severity: "High"
            }];
        } else {
            const res = await fetch(
                `/api/alerts?lat=${userAlertLat}&lon=${userAlertLng}`
            );
            const data = await res.json();
            alerts = data.success ? data.alerts : [];
        }

        const banner = document.getElementById("alertBanner");
        const bannerMobile = document.getElementById("alertBannerMobile");

        if (alerts.length > 0) {
            const html = renderAlert(alerts[0]);
            if (banner) banner.innerHTML = html;
            if (bannerMobile) bannerMobile.innerHTML = html;
        } else {
            if (banner) banner.innerHTML = "";
            if (bannerMobile) bannerMobile.innerHTML = "";
        }

    } catch (err) {
        console.error("Failed to load alerts:", err);
    }
}
// ============================================================
// IP-BASED LOCATION 
// ============================================================

async function getLocationFromIP() {

    try {

        const res = await fetch("https://ipapi.co/json/");
        const data = await res.json();

        if (data.latitude && data.longitude) {
            return {
                lat: data.latitude,
                lng: data.longitude
            };
        }

        return null;

    } catch (err) {
        console.warn("IP location failed:", err);
        return null;
    }
}

async function initLocationBasedAlerts() {

    const location = await getLocationFromIP();

    if (!location) {
        console.warn("Location detect nahi ho payi, alerts skip.");
        return;
    }

    userAlertLat = location.lat;
    userAlertLng = location.lng;

    loadAlertsForCurrentLocation();

    // Har 60 second mein dobara check karo (usi location ke liye)
    setInterval(loadAlertsForCurrentLocation, 60000);
}

initLocationBasedAlerts();

    </script>

